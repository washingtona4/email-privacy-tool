"],"smartCropGravity":"faces","smartCropH":100,"smartCropW":100}],"variant":"AWS","weatherQueryParams":{"lang":"en-US","region":"US","severeAlertsSeverity":"MINOR","unit":"F","woeid":[12784073]}},"extensions":{"clientLibrary":{"name":"@apollo/client","version":"4.1.6"}},"query":"query UserConvenienceData($eventsQueryParams: EventsQueryParams!, $financeQueryParams: FinanceQueryParams!, $horoscopeClientContext: HoroscopeClientContext, $horoscopeConfig: HoroscopeConfig, $skipWeather: Boolean!, $skipLocalEvents: Boolean!, $skipHoroscope: Boolean!, $transformInputs: [MysterioTransformsInput]!, $weatherQueryParams: WeatherQueryInput!, $variant: Variant) {\n  horoscope(\n    clientContext: $horoscopeClientContext\n    horoscopeConfig: $horoscopeConfig\n  ) @skip(if: $skipHoroscope) {\n    body\n    category\n    description\n    frequencyInfo {\n      currentValue\n      previousValue\n      name\n      nextValue\n      __typename\n    }\n    endDate\n    id\n    startDate\n    summary\n    title\n    zodiacSign\n    zodiacType\n    __typename\n  }\n  weather: weatherData(weatherQueryInput: $weatherQueryParams) @skip(if: $skipWeather) {\n    current_observations: currentObservations {\n      result {\n        condition_code: conditionCode\n        condition_description: conditionDescription\n        feels_like_temperature: feelsLikeTemperature\n        temperature\n        uv_index: uvIndex\n        uv_description: uvDescription\n        __typename\n      }\n      __typename\n    }\n    unified_geo_locations: unifiedGeoLocations {\n      result {\n        display_name: displayName\n        woeid\n        timezone_id: timezoneId\n        country_code: countryCode\n        admin1_code: admin1Code\n        admin1_name: admin1Name\n        postal_town_name: postalTownName\n        __typename\n      }\n      __typename\n    }\n    daily_forecasts: dailyForecasts {\n      result {\n        condition_code: conditionCode\n        forecast_time: forecastTime\n        high_temperature: highTemperature\n        low_temperature: lowTemperature\n        sunrise_secs_from_midnight: sunriseSecsFromMidnight\n        sunset_secs_from_midnight: sunsetSecsFromMidnight\n        __typename\n      }\n      __typename\n    }\n    warning: warning {\n      result {\n        event\n        expires\n        severity\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n  quoteResponse(financeQueryParams: $financeQueryParams) {\n    result {\n      fullExchangeName\n      regularMarketChange {\n        fmt\n        __typename\n      }\n      regularMarketChangePercent {\n        fmt\n        raw\n        __typename\n      }\n      regularMarketPrice {\n        fmt\n        __typename\n      }\n      symbol\n      __typename\n    }\n    __typename\n  }\n  newsEventsAndLocation(eventsQueryParams: $eventsQueryParams, variant: $variant) @skip(if: $skipLocalEvents) {\n    loc {\n      city\n      state\n      city_state\n      __typename\n    }\n    events {\n      id\n      title\n      city\n      venueName\n      displayStartDate\n      eventUrl {\n        source\n        url\n        affiliateUrl(\n          input: {pageId: \"1p-autolink\", affiliateTrackingInput: {featureId: \"events-near-me\"}}\n        )\n        __typename\n      }\n      images {\n        mysterioImages(transformInputs: $transformInputs) {\n          height\n          url\n          width\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}"},7:headers;4097:96:10:user-agent,78:Mozilla/5.0 (X11; Ubuntu; Linux x86_64; rv:149.0) Gecko/20100101 Firefox/149.0,]69:6:accept,56:application/graphql-response+json,application/json;q=0.9,]37:15:accept-language,14:en-US,en;q=0.9,]46:15:accept-encoding,23:gzip, deflate, br, zstd,]36:7:referer,22:https://www.yahoo.com/,]36:12:content-type,16:application/json,]25:7:x-crumb,11:.xly066vHwb,]57:21:x-yahoo-yf-client-cid,28:ncg.subgraph-yf.home-slimjim,]33:22:x-yahoo-cg-client-name